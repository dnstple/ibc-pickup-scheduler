# Filled in automatically by `shopify app dev`; set manually for production hosting.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,read_orders,read_merchant_managed_fulfillment_orders
# Postgres connection string (Vercel Postgres/Neon adds this automatically
# when you connect the storage to the project)
DATABASE_URL=
